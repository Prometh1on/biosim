# Copy this file to .env in the repository root (docker-compose reads it
# automatically from there) and set real local-development values.
# Never commit a populated .env file -- these are local secrets, even
# though the shipped defaults in docker-compose.yml are throwaway values
# documented as such.

BIOSIM_PG_PASSWORD=change_me_local_dev_only
BIOSIM_NEO4J_PASSWORD=change_me_local_dev_only
